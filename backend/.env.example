NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Optional: create the first organizer on initial startup
BOOTSTRAP_ORGANIZER_NAME="CampusPlay Organizer"
BOOTSTRAP_ORGANIZER_EMAIL=organizer@campusplay.local
BOOTSTRAP_ORGANIZER_PASSWORD="ChangeMe-Immediately-123!"
